    "content_de": {
      "hero": {
        "title": "Über Uns",
        "subtitle": "15 Jahre Markenbeleuchtung in ganz Europa"
      },
      "narrative": {
        "title": "Transformation",
        "titleLine2": "von Unternehmen",
        "paragraph1": "Seit 2009 fertigt Prem-Lichtwerbung Premium-Leuchtreklame, die Unternehmen in Wahrzeichen verwandelt. Was als kleine Werkstatt in Deutschland begann, hat sich zu einem führenden Anbieter von individuellen Beleuchtungslösungen in ganz Europa entwickelt.",
        "paragraph2": "Wir glauben, dass jedes Unternehmen Beschilderung verdient, die nicht nur unglaublich aussieht, sondern auch jahrelang einwandfrei funktioniert. Deshalb verwenden wir in jedem Projekt nur hochwertigste Materialien, LED-Technologie und wetterfeste Konstruktion."
      },
      "values": {
        "title": "UNSERE WERTE",
        "quality": {
          "title": "Premium-Qualität",
          "description": "Wir verwenden nur hochwertigste Materialien und LED-Technologie. Jedes Schild ist für eine Lebensdauer von über 10 Jahren mit minimalem Wartungsaufwand gebaut."
        },
        "custom": {
          "title": "Individuelles Design",
          "description": "Jedes Projekt ist einzigartig. Unser Designteam arbeitet mit Ihnen zusammen, um Beschilderung zu erstellen, die perfekt zu Ihrer Markenidentität passt."
        },
        "turnaround": {
          "title": "Schnelle Bearbeitung",
          "description": "Die meisten Bestellungen sind in 7-14 Tagen fertig. Brauchen Sie es schneller? Wir bieten Express-Produktion für dringende Projekte an."
        },
        "expertise": {
          "title": "Bewährte Expertise",
          "description": "Über 500 zufriedene Kunden in ganz Europa vertrauen uns ihre Markensichtbarkeit an. Schließen Sie sich ihnen an."
        }
      },
      "capabilities": {
        "title": "Was wir erschaffen",
